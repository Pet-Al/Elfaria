{
  "name": "elfaria",
  "version": "1.0.0",
  "description": "Elfaria — a discord.js v14 music bot (single-process v1).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:sharded": "tsx src/shard.ts",
    "deploy": "tsx deploy-commands.ts",
    "deploy:list": "tsx deploy-commands.ts --list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "lavalink-client": "^2.10.3",
    "pg": "^8.22.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
