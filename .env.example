# ─── Discord credentials (REQUIRED) ───────────────────────────────────────────
# Your bot token is a full credential. Treat it like a password.
# Never commit the real .env — only this .example file is tracked.
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here

# Optional: a single guild (server) ID. Elfaria registers commands GLOBALLY only
# (guild-scoped registration was removed — it's the sole cause of doubled
# commands). This is now used purely for diagnostics/cleanup: `npm run deploy:list`
# checks this guild for leftover dupes, and the bot clears them on boot. Leave
# empty unless you're hunting an orphaned guild registration. See deploy-commands.ts.
DISCORD_GUILD_ID=

# Auto-register slash commands GLOBALLY every time the bot boots, so a fresh
# build/restart never needs a separate `npm run deploy` (the usual cause of
# "my commands aren't global / didn't update"). Idempotent; on by default.
# Set to false ONLY if you manage registration manually via `npm run deploy`.
# NOTE: global propagation still takes up to ~1 hour the first time a NEW command
# name appears — that's a Discord limit.
AUTO_DEPLOY_COMMANDS=true

# Commands are GLOBAL-only. On boot the bot clears any leftover GUILD-scoped
# commands (the only cause of doubled commands). ON by default; set false only at
# very large guild counts where the per-guild boot API call is too costly.
CLEAR_ALL_GUILD_COMMANDS=true

# ─── Runtime configuration (OPTIONAL — sensible defaults shown) ───────────────
# SQLite file path — used only when DATABASE_URL is unset (e.g. a non-Docker
# `npm start` for local dev).
DATABASE_PATH=./data/elfaria.db

# The data store. With docker compose this DEFAULTS to the bundled `postgres`
# service (both the small and scale stacks use the SAME Postgres volume, so your
# data is consistent across them) — you do NOT need to set it here.
# Set it only to point at an EXTERNAL/managed database, or leave it empty for a
# non-Docker run to use embedded SQLite (zero-config dev).
DATABASE_URL=

# Optional Postgres READ REPLICA (HA / read scaling — see docs/DATA.md and
# k8s/postgres-ha.yaml). When set, heavy analytics reads (top-tracks, the
# recommender's co-play + training queries) go here instead of the primary; the
# transactional path always uses DATABASE_URL. With CloudNativePG point this at
# the `-ro` service. Leave empty to read everything from the primary.
DATABASE_REPLICA_URL=

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Node environment: development | production (controls pretty logging).
NODE_ENV=development

# Default playback volume (0–100) for new queues; per-guild override lives in DB.
DEFAULT_VOLUME=80

# Leave the voice channel after it has been empty for this many milliseconds.
LEAVE_ON_EMPTY_COOLDOWN_MS=120000

# Leave the voice channel this many milliseconds after the queue ends.
LEAVE_ON_END_COOLDOWN_MS=120000

# Leave this many milliseconds after a song is PAUSED (and left paused). Longer
# than the others on purpose — a pause is intentional, so the bot waits ~10 min
# before giving up the channel rather than the quick empty/queue-end cooldown.
PAUSE_LEAVE_COOLDOWN_MS=600000

# Default search source for plain-text queries (links are auto-detected):
#   ytsearch (YouTube) | ytmsearch (YouTube Music) | scsearch (SoundCloud) | spsearch
DEFAULT_SEARCH_PLATFORM=ytsearch

# Default per-user command cooldown (ms) when a command does not set its own.
DEFAULT_COOLDOWN_MS=3000

# Autoplay buffer: how many related tracks autoplay keeps queued ahead when the
# queue runs dry (so there's always an "up next", not just one song). Use
# /autoplay to toggle it per server and /reroll to swap in a fresh shuffle.
AUTOPLAY_QUEUE_SIZE=5

# Error-storm backstop: stop a player only after this many stuck/errored tracks
# within the window. Keep it lenient — too tight and a throttled YouTube stream
# (repeated stalls) wrongly kills the session ("song randomly dies"). Individual
# bad tracks auto-skip regardless. The real throttling fix is YouTube OAuth.
MAX_TRACK_ERRORS=10
MAX_TRACK_ERRORS_WINDOW_MS=60000

# ─── Lavalink (audio service) ─────────────────────────────────────────────────
# Audio is handled by a Lavalink node (see docker-compose.yml). When running via
# docker compose, the bot reaches it at host "lavalink" — these are overridden in
# compose, so you normally only need to set the PASSWORD here (used by BOTH the
# bot and the Lavalink container). Treat it like a credential.
LAVALINK_PASSWORD=youshallnotpass
# Only needed when NOT using docker compose (e.g. a remote/standalone Lavalink):
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_SECURE=false

# Multiple Lavalink nodes (doc §9) — leave empty for the single node above. When
# set, this JSON array takes precedence and sessions balance across all nodes.
# Per-node "authorization" is optional: omit it and the node inherits
# LAVALINK_PASSWORD (so the secret lives in one place).
#   LAVALINK_NODES=[{"id":"a","host":"lavalink","port":2333},{"id":"b","host":"node2","port":2333}]
LAVALINK_NODES=

# ─── Scaling (OPTIONAL — all off by default; doc §9) ──────────────────────────
# RULE: these belong in .env ONLY when you scale WITHOUT the override file (e.g.
# your own external Redis/Postgres). If you use docker-compose.scale.yml to test
# or run the distributed stack, LEAVE THEM AT THE DEFAULTS BELOW — the override
# supplies the real values, and it always wins over .env (see README "How the
# compose files layer"). Turning them on here as well would break a plain
# `docker compose up`, which doesn't start the redis/postgres services.
#
# Shared search cache across processes/shards. Empty = in-memory (single
# process). With docker compose, enable the `redis` service and set:
#   REDIS_URL=redis://redis:6379
REDIS_URL=

# Sharding — only needed near ~2,500 guilds. Off by default (single process).
# Set SHARDING=on and run `npm run start:sharded` (or override the compose
# command). SHARD_COUNT is "auto" or a fixed number.
SHARDING=off
SHARD_COUNT=auto

# Multi-pod sharding (doc: docs/SCALING_SHARDING.md). For the biggest scale, run
# `npm start` per pod and give each a coordinated, disjoint shard range. Set
# TOTAL_SHARDS (the SAME global count on every pod) + SHARDS_PER_POD; each pod
# derives its slice from its StatefulSet ordinal (POD_NAME, injected in k8s).
# Leave TOTAL_SHARDS empty for single-process / ShardingManager mode.
#   TOTAL_SHARDS=12
#   SHARDS_PER_POD=3
#   POD_NAME=elfaria-bot-0        # k8s sets this from metadata.name
#   SHARD_IDS=                    # or pin shards explicitly, e.g. 0,2,4
TOTAL_SHARDS=
SHARDS_PER_POD=1

# ─── Observability (OPTIONAL) ─────────────────────────────────────────────────
# Prometheus metrics endpoint (GET /metrics on METRICS_PORT). On by default;
# set METRICS_ENABLED=false to disable it. Exposes command RED metrics, process
# stats, and live player/connected-node gauges (the signal the audio HPA wants).
METRICS_ENABLED=true
METRICS_PORT=9090

# Distributed tracing (OpenTelemetry). OFF unless this points at an OTLP/HTTP
# collector (e.g. http://otel-collector:4318); then command + source-resolve
# spans (bot→Lavalink) are exported. Leave empty to disable (zero overhead).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Now-playing card refresh interval (ms) — drives the live timer AND the synced
# lyrics line. 1000 = smooth per-second updates (nice, but editing one message
# per active guild every second eats the ~50 req/s global budget — RAISE this at
# large scale, or set 0 to disable live updates).
NOWPLAYING_REFRESH_MS=1000

# ─── Analytics, API, retention (OPTIONAL) ─────────────────────────────────────
# Event pipeline: play/skip/search events always go to the DB. Set KAFKA_BROKERS
# (comma-separated host:port) to ALSO publish them to Kafka for a warehouse.
# KAFKA_BROKERS=
KAFKA_TOPIC=elfaria.events

# Read-only public stats API + web dashboard (aggregate, no PII): a dashboard at
# /, plus /api/health, /api/stats, /api/top-tracks. Off by default.
API_ENABLED=false
API_PORT=8080

# End-to-end PLAY canary (optional). Periodically joins a DEDICATED staging voice
# channel, plays a known track, checks the position actually advances (real
# audio), then leaves — exported as elfaria_play_canary_success. Leave empty to
# disable. DO NOT point this at a channel people use; it interrupts playback.
CANARY_GUILD_ID=
CANARY_VOICE_CHANNEL_ID=
CANARY_TEXT_CHANNEL_ID=
CANARY_QUERY=ytsearch:lofi

# Bot owner's Discord user id — may use the owner-only /admin toggles (turn the
# 90-day retention deletion on/off, enable/disable user access to /forget-me).
OWNER_ID=582699270369574912

# GDPR data retention: play history + analytics events older than this many days
# are pruned daily (see PRIVACY.md and /forget-me). The owner can disable the
# deletion at runtime with `/admin retention off`.
DATA_RETENTION_DAYS=90

# Trained recommender (item2vec). Run `npm run train` to learn track embeddings
# from the accumulated play events and write the artifact here; the bot loads it
# on boot and autoplay uses it ahead of the heuristics. Absent = heuristics only
# (cold start). Re-run periodically (e.g. a nightly CronJob) to keep it fresh.
RECOMMENDER_MODEL_PATH=./data/recommender.json

# ─── Spotify credentials (OPTIONAL — enables Spotify links + spsearch) ────────
# Like the Discord token, the Client Secret is a credential: treat it like a
# password and NEVER commit your real .env.
# The LavaSrc plugin is enabled by default; just add the app credentials below to
# turn Spotify on, then: docker compose up -d --force-recreate lavalink
# Create an app at https://developer.spotify.com/dashboard. These are APP
# credentials (Web API), NOT your account login — the bot never logs into your
# Spotify account, so there's no ban risk. A free account works; Premium is not
# required. Spotify gives metadata only; the audio is bridged from YouTube/SoundCloud.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Lavalink plugin migration (OPTIONAL — see docs/PLUGINS.md) ───────────────
# These plugins are declared in lavalink/application.yml; the flags below decide
# whether the BOT uses them. Each defaults to Elfaria's original path, so flip a
# flag only AFTER you've confirmed Lavalink boots with the plugin — then flip
# back instantly if anything misbehaves (the old code path is always intact).
#
# Synced-lyrics source for the now-playing card:
#   lrclib   — built-in LRCLIB HTTP client (default, proven)
#   lavalink — the LavaLyrics plugin via the node, with an automatic LRCLIB fallback
LYRICS_SOURCE=lrclib
# Show the LavaDSPX filter presets (normalize / echo) in /filter. Needs the
# LavaDSPX plugin installed; when false those presets are hidden.
LAVA_DSPX=false
# Use the LavaSearch plugin for richer search (falls back to the normal search on
# any miss/error). Best with LavaSrc sources (Spotify/Apple/Deezer).
LAVASEARCH=false
# /tts text-to-speech via the DuncteBot plugin's free `speak:` source (no creds).
# On by default since the plugin ships in application.yml; set false to disable.
TTS_ENABLED=true

# Google Cloud TTS (OPTIONAL — only if you uncomment the tts-plugin in
# application.yml for higher-quality neural voices). Paste a GCP service account's
# values; leave blank to keep using DuncteBot's free speak: source instead.
# GCP_TTS_CLIENT_EMAIL=
# GCP_TTS_PRIVATE_KEY=
# Genius API token (OPTIONAL) — enables java-timed-lyrics' Genius fallback. Get
# one at https://genius.com/api-clients, then uncomment geniusApiKey in
# application.yml under plugins.lyrics.
# GENIUS_API_KEY=

# NOTE: any old YOUTUBE_STREAM_CLIENT / YOUTUBE_PO_TOKEN / YOUTUBE_COOKIE entries
# are obsolete and ignored — YouTube client selection now lives in
# lavalink/application.yml (plugins.youtube.clients). Safe to delete them.
