{
  "name": "elfaria",
  "version": "1.0.0",
  "description": "Elfaria — a discord.js v14 music bot (single-process v1).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:sharded": "tsx src/shard.ts",
    "deploy": "tsx deploy-commands.ts",
    "deploy:global": "tsx deploy-commands.ts --global",
    "deploy:guild": "tsx deploy-commands.ts --guild",
    "deploy:list": "tsx deploy-commands.ts --list",
    "train": "tsx scripts/train-recommender.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --import ./test/setup.mjs --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import ./test/setup.mjs --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"test/**\" --test-coverage-lines=60 --test-coverage-functions=55 --test-coverage-branches=75 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.55.3",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "lavalink-client": "^2.10.3",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "optionalDependencies": {
    "kafkajs": "^2.2.4",
    "sharp": "^0.35.2"
  }
}
