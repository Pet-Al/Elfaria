{
  "name": "elfaria",
  "version": "1.0.0",
  "description": "Elfaria — a discord.js v14 music bot (single-process v1).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "deploy": "tsx deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@discord-player/extractor": "^7.1.0",
    "better-sqlite3": "^11.8.1",
    "discord-api-types": "^0.38.1",
    "discord-player": "^7.1.0",
    "discord-player-youtubei": "^1.3.7",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "mediaplex": "^1.0.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
